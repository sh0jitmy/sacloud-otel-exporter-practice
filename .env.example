# ==============================================================================
# さくらのオブジェクトストレージ & sacloud-otel-collector 設定用環境変数
# ==============================================================================
# このファイルを .env にコピーして、ご自身の環境に合わせて値を設定してください。
#   cp .env.example .env
# ==============================================================================

# さくらのオブジェクトストレージ エンドポイント
# - 石狩第1サイト (推奨): https://s3.isk01.sakurastorage.jp
# - 東京第1サイト:        https://s3.tky01.sakurastorage.jp
SACLOUD_O2_ENDPOINT=https://s3.isk01.sakurastorage.jp

# さくらのオブジェクトストレージ リージョン
# - 石狩第1サイト: jp-north-1
# - 東京第1サイト: jp-east-1
SACLOUD_O2_REGION=jp-north-1

# 保存先バケット名
SACLOUD_O2_BUCKET=your-bucket-name

# ログを格納するキープレフィックス (デフォルト: logs)
SACLOUD_O2_PREFIX=logs

# さくらのオブジェクトストレージ APIキー (コントロールパネルで発行)
SACLOUD_O2_ACCESS_KEY=your-access-key
SACLOUD_O2_SECRET_KEY=your-secret-key

# AWS SDK v2 互換用環境変数 (Collector で使用)
# ※ さくらのオブジェクトストレージ等の S3 互換ストレージにおけるチェックサムエラー (400) を回避するために必須です
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED

# sacloud-otel-collector の OTLP 受信エンドポイント (デフォルト: localhost:4317)
OTEL_COLLECTOR_ENDPOINT=localhost:4317
OTEL_COLLECTOR_INSECURE=true

# 検証用パラメータ
LOG_COUNT=5
FLUSH_WAIT_TIME=4s
